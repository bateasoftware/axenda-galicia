ANTHROPIC_API_KEY=
# MODELO_EXTRACCION=claude-sonnet-5-5
NEXT_PUBLIC_SITE_URL=https://axenda-galicia.vercel.app
# Correo al que los organizadores mandan los carteles (por defecto bateasoftware@gmail.com)
# NEXT_PUBLIC_EMAIL_ENVIO=

# Supabase: pendientes, publicados desde el panel y carteles (supabase/esquema.sql).
# Sin estas variables, en local se usan data/pendientes y data/eventos.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # secreta: solo servidor y scripts

# Panel de revisión /admin
# ADMIN_CLAVE=                      # contraseña del panel (larga)

# Entrada por API (/api/entrada, Apps Script de Gmail). Ver docs/entrada-automatica.md
# ENTRADA_SECRETO=
# Sin Supabase, /api/entrada abre un PR en GitHub:
# GITHUB_TOKEN=
# GITHUB_REPO=bateasoftware/axenda-galicia

# WhatsApp Business Cloud API (/api/whatsapp). Ver docs/pendientes-juan.md
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PLANTILLA_PUBLICADO=evento_publicado
# NEXT_PUBLIC_WHATSAPP_NUMERO=34600000000   # se muestra en /enviar

# Antispam del formulario de /enviar (Cloudflare Turnstile, opcional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
