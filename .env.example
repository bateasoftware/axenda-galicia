# API de Claude (de pago por uso). Sin ella, lo recibido queda "por completar" en /admin. Ver docs/pendientes-juan.md
# ANTHROPIC_API_KEY=
# MODELO_EXTRACCION=claude-sonnet-5-5
NEXT_PUBLIC_SITE_URL=https://axenda-galicia.vercel.app
# Correo al que los organizadores mandan los carteles (por defecto bateasoftware@gmail.com)
# NEXT_PUBLIC_EMAIL_ENVIO=

# Base de datos: pendientes y publicados desde el panel. Sin ella, en local se usan data/pendientes y data/eventos.
# Turso (las tablas se crean solas; los carteles se guardan en la propia base de datos):
# TURSO_DATABASE_URL=libsql://axenda-xxxx.turso.io
# TURSO_AUTH_TOKEN=                 # secreto
# BLOB_READ_WRITE_TOKEN=            # opcional: carteles en Vercel Blob en vez de en Turso
# Supabase (alternativa; migración con npm run migrar-a-supabase). Si están las de Turso, se usa Turso.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # secreta: solo servidor y scripts

# Panel de revisión /admin
# ADMIN_CLAVE=                      # contraseña del panel (larga)

# Entrada por API (/api/entrada, Apps Script de Gmail). Ver docs/entrada-automatica.md
# ENTRADA_SECRETO=
# Sin Supabase, /api/entrada abre un PR en GitHub:
# GITHUB_TOKEN=
# GITHUB_REPO=bateasoftware/axenda-galicia

# WhatsApp Business Cloud API (/api/whatsapp). Ver docs/pendientes-juan.md
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PLANTILLA_PUBLICADO=evento_publicado
# NEXT_PUBLIC_WHATSAPP_NUMERO=34600000000   # se muestra en /enviar

# Antispam del formulario de /enviar (Cloudflare Turnstile, opcional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Estadísticas (sin cookies). Vercel Analytics y Speed Insights se activan en el panel de Vercel.
# GOOGLE_SITE_VERIFICATION=          # valor de la meta de Google Search Console
# INFORMES_SECRETO=                  # firma de los enlaces de informes de organizadores (si no, ADMIN_CLAVE)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=      # alternativa: Plausible
# NEXT_PUBLIC_PLAUSIBLE_SRC=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=      # alternativa: Umami
# NEXT_PUBLIC_UMAMI_SRC=
